# Canonical origin used in the sitemap, robots.txt, and page metadata.
# Set this to the production domain before deploying on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay key id is safe to send to the browser. The secret and webhook secret
# must stay on the server. Never prefix them with NEXT_PUBLIC_.
# Use rzp_test_ keys until Razorpay has approved the website, then switch to rzp_live_.
# In the Razorpay dashboard, turn on automatic capture, and set the webhook URL to
# https://YOUR_DOMAIN/api/razorpay/webhook for payment.captured, payment.failed, and order.paid.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# MongoDB database for accounts. Example: mongodb://127.0.0.1:27017/papernikalo
MONGODB_URI=
# At least 32 characters. Used to sign the 5-minute access key. Keep it on the server.
AUTH_SECRET=
